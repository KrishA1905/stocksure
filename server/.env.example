# Copy to .env and fill in. NEVER commit .env.
# MySQL connection string (database is created by `prisma migrate dev`)
DATABASE_URL="mysql://root:password@localhost:3306/stocksure"

# >= 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Comma-separated list of allowed front-end origins (CORS + credentials)
CLIENT_ORIGIN="http://localhost:5173"

NODE_ENV=development
PORT=5000

# Optional
SESSION_MAX_AGE_MINUTES=120
# lax for same-site dev (localhost:5173 -> localhost:5000). Use none (+HTTPS) only for cross-site deployments.
COOKIE_SAMESITE=lax
# Set to 1 when running behind a reverse proxy / load balancer that terminates TLS
TRUST_PROXY=0
LOGIN_RATE_LIMIT=20

# Separate database used by `npm test` - it is WIPED and re-seeded on every run.
DATABASE_URL_TEST="mysql://root:password@localhost:3306/stocksure_test"

# Calendar-day rules (overdue, renewal cut-off) are evaluated in this timezone
APP_TIMEZONE=Asia/Kolkata

# Max APPROVED renewals per issue (department policy)
MAX_RENEWALS_PER_ISSUE=2
